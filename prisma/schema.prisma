// Prisma Schema for Hardware Shop Management System
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum UnitType {
  PIECE
  KG
  METER
  BOX
}



enum CustomerType {
  REGULAR
  ELECTRICIAN
  PLUMBER
}

enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

enum TransactionType {
  SALE
  PURCHASE
  ADJUSTMENT
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  CREDIT
}

// ==================== MODELS ====================

model Supplier {
  id             String     @id @default(uuid())
  name           String
  contactPerson  String?
  phone          String
  email          String?
  address        String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  
  // Relations
  products       Product[]
  purchases      Purchase[]

  @@index([name])
  @@map("suppliers")
}

model Product {
  id              String     @id @default(uuid())
  sku             String     @unique
  name            String
  description     String?
  category        String
  unitType        UnitType
  currentStock    Float      @default(0)
  minStockLevel   Float      @default(0)
  costPrice       Float
  supplierId      String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  
  // Relations
  supplier        Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  pricingTiers    PricingTier[]
  saleItems       SaleItem[]
  purchaseItems   PurchaseItem[]
  inventoryTransactions InventoryTransaction[]

  @@index([sku])
  @@index([category])
  @@index([supplierId])
  @@map("products")
}

model PricingTier {
  id            String       @id @default(uuid())
  productId     String
  customerType  CustomerType
  sellingPrice  Float
  minQuantity   Float        @default(1)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  
  // Relations
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, customerType])
  @@index([productId])
  @@map("pricing_tiers")
}

model Customer {
  id                  String       @id @default(uuid())
  name                String
  phone               String       @unique
  email               String?
  address             String?
  customerType        CustomerType @default(REGULAR)
  creditLimit         Float        @default(0)
  outstandingBalance  Float        @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  
  // Relations
  sales               Sale[]

  @@index([phone])
  @@index([customerType])
  @@map("customers")
}

model Sale {
  id              String        @id @default(uuid())
  billNumber      String        @unique
  customerId      String?
  saleDate        DateTime      @default(now())
  subtotal        Float
  discount        Float         @default(0)
  tax             Float         @default(0)
  totalAmount     Float
  paymentStatus   PaymentStatus @default(UNPAID)
  paymentMethod   PaymentMethod @default(CASH)
  createdBy       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  // Relations
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  saleItems       SaleItem[]
  paymentTransactions PaymentTransaction[]

  @@index([billNumber])
  @@index([customerId])
  @@index([saleDate])
  @@index([paymentStatus])
  @@map("sales")
}

model SaleItem {
  id          String   @id @default(uuid())
  saleId      String
  productId   String
  quantity    Float
  unitPrice   Float
  lineTotal   Float
  createdAt   DateTime @default(now())
  
  // Relations
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model Purchase {
  id                  String        @id @default(uuid())
  purchaseOrderNumber String        @unique
  supplierId          String
  purchaseDate        DateTime      @default(now())
  totalAmount         Float
  paymentStatus       PaymentStatus @default(UNPAID)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  
  // Relations
  supplier            Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseItems       PurchaseItem[]

  @@index([purchaseOrderNumber])
  @@index([supplierId])
  @@index([purchaseDate])
  @@map("purchases")
}

model PurchaseItem {
  id          String   @id @default(uuid())
  purchaseId  String
  productId   String
  quantity    Float
  unitCost    Float
  lineTotal   Float
  createdAt   DateTime @default(now())
  
  // Relations
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model InventoryTransaction {
  id              String          @id @default(uuid())
  productId       String
  transactionType TransactionType
  quantity        Float
  referenceId     String?
  referenceType   String?
  notes           String?
  createdAt       DateTime        @default(now())
  
  // Relations
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([transactionType])
  @@index([createdAt])
  @@map("inventory_transactions")
}

model PaymentTransaction {
  id              String        @id @default(uuid())
  saleId          String
  amount          Float
  paymentMethod   PaymentMethod
  transactionDate DateTime      @default(now())
  notes           String?
  createdAt       DateTime      @default(now())
  
  // Relations
  sale            Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([transactionDate])
  @@map("payment_transactions")
}
